ARG AICHECK_SERVER_BASE_IMAGE=python:3.12-slim
FROM ${AICHECK_SERVER_BASE_IMAGE}

USER root

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com

# LibreOffice headless：Office 资料转 PDF 在线预览（L-4）。
# 用国内源——默认 deb.debian.org 在这个网络下 14 KB/s。原用腾讯源（708 KB/s），
# 2026-11-03 起对生产主机（阿里云）回 HTTP 567、签名校验失败，改阿里云源（实测 748 KB/s）。
# --no-install-recommends 省掉字体外的一堆桌面依赖；只装 writer/calc/impress，
# 监检资料就这三类。fonts-wqy-zenhei 是中文必需，缺了转出来全是方块。
ARG AICHECK_DEBIAN_MIRROR=mirrors.aliyun.com
RUN set -eux; \
    sed -i "s|deb.debian.org|${AICHECK_DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libreoffice-writer libreoffice-calc libreoffice-impress \
        fonts-wqy-zenhei fonts-wqy-microhei; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt \
    && (getent group aicheck >/dev/null || groupadd --system aicheck) \
    && (id -u aicheck >/dev/null 2>&1 || useradd --system --gid aicheck --home-dir /app aicheck)
COPY . .
RUN chown -R aicheck:aicheck /app

USER aicheck

EXPOSE 8000 8010

# 版本标签放最后（2026-11-04）：原来在最前面，每次提交号一变，后面 LibreOffice、pip 两层的缓存全失效，
# 每次部署都重装依赖、多花约 20 分钟。部署校验（verify_runtime_revision）读的就是这个标签。
ARG AICHECK_REVISION=unknown
LABEL org.opencontainers.image.revision=${AICHECK_REVISION}
