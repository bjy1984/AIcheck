# AIcheck production-like deployment template.
# Copy to backend/.env and replace every placeholder before running Docker Compose.

# Optional: only needed when AICHECK_ENABLE_AGENTDESIGN_SEAL_OCR=true.
AICHECK_AGENTDESIGN_HOST_PATH=
AICHECK_OCR_MODELS_HOST_PATH=/Volumes/Volume/project/aicheck-ocr-models

AICHECK_MINIO_ACCESS_KEY=aicheck
AICHECK_MINIO_SECRET_KEY=replace-with-strong-minio-secret
AICHECK_JWT_SECRET=replace-with-64-plus-character-random-secret
AICHECK_JWT_ISSUER=aicheck-api
AICHECK_JWT_AUDIENCE=aicheck-frontend
AICHECK_JWT_TTL_MINUTES=720
AICHECK_STRICT_PRODUCTION=true
AICHECK_ALLOW_DEV_TOKENS=false
AICHECK_ENABLE_COMPATIBILITY_MOCKS=false
AICHECK_CORS_ALLOWED_ORIGINS=https://aicheck.example.com
AICHECK_ALLOWED_HOSTS=aicheck.example.com,api-service,127.0.0.1,localhost
AICHECK_TRUST_PROXY=false
AICHECK_TRUSTED_PROXIES=

LITELLM_API_KEY=replace-with-litellm-master-key
AICHECK_LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.84.3@sha256:67c31510b20e60e8eb1670b9c47714c1c519cb04f5e5c077cf1f12073bf8fb30
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
OPENAI_API_KEY=
INFINITY_API_KEY=replace-with-local-infinity-api-key

AICHECK_QWEN_CALL_MODE=official_api
AICHECK_QWEN_ALLOW_SERVER_FALLBACK=false
AICHECK_QWEN_REVIEW_TIMEOUT_SECONDS=180
AICHECK_QWEN_REVIEW_MAX_TOKENS=1600
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=replace-with-qwen-official-api-key

AICHECK_EMBEDDING_PROVIDER=local
AICHECK_EMBEDDING_API_BASE=http://embedding-service:7997
AICHECK_EMBEDDING_API_KEY=replace-with-local-infinity-api-key
AICHECK_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
AICHECK_EMBEDDING_SERVED_MODEL_NAME=embedding-default
AICHECK_EMBEDDING_BATCH_SIZE=32
AICHECK_EMBEDDING_ENGINE=torch
AICHECK_EMBEDDING_ALLOW_HASH_FALLBACK=false
AICHECK_LOCAL_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
AICHECK_LOCAL_EMBEDDING_SERVED_MODEL_NAME=embedding-default
AICHECK_LOCAL_EMBEDDING_ENGINE=torch
AICHECK_EMBEDDING_CACHE_HOST_PATH=/tmp/aicheck-embedding-cache
HF_ENDPOINT=https://hf-mirror.com

# Optional build mirrors for China-hosted deployments. Leave blank to use upstream defaults.
AICHECK_APT_DEBIAN_MIRROR=
AICHECK_APT_SECURITY_MIRROR=
AICHECK_PIP_INDEX_URL=

AICHECK_POSTGRES_DB=aicheck
AICHECK_POSTGRES_USER=aicheck
AICHECK_POSTGRES_PASSWORD=replace-with-strong-postgres-password
AICHECK_DATABASE_URL=postgresql://aicheck:replace-with-strong-postgres-password@postgres:5432/aicheck
AICHECK_TENANT_ID=TENANT-DEFAULT
AICHECK_TENANT_MODE=shared
AICHECK_REQUIRE_PGVECTOR=true
AICHECK_OUTBOX_POLL_SECONDS=1
AICHECK_OUTBOX_BATCH_SIZE=20
AICHECK_OUTBOX_MAX_ATTEMPTS=10
AICHECK_OUTBOX_RECONCILE_SECONDS=120
AICHECK_OUTBOX_MAX_RECONCILIATIONS=5
AICHECK_IDEMPOTENCY_LOCK_TIMEOUT_MS=5000
AICHECK_REQUIRE_AUDIT_ANCHOR=true
AICHECK_AUDIT_ANCHOR_OBJECT_LOCK=true
AICHECK_AUDIT_ANCHOR_INTERVAL_SECONDS=300
AICHECK_AUDIT_ANCHOR_RETENTION_DAYS=3650
AICHECK_MINIO_AUDIT_ANCHORS_BUCKET=audit-anchors
AICHECK_POSTGRES_IMAGE=pgvector/pgvector:pg16
AICHECK_RULES_HOST_PATH=../rules
AICHECK_SQLITE_FALLBACK=false
AICHECK_SQLITE_DISABLE=true
AICHECK_REDIS_URL=redis://redis:6379/0
AICHECK_TASK_DISPATCH=celery
AICHECK_REVIEW_ORCHESTRATION=temporal
TEMPORAL_ADDRESS=temporal-service:7233
TEMPORAL_NAMESPACE=default
AICHECK_REVIEW_WORKFLOW_TASK_QUEUE=review.workflow
AICHECK_REVIEW_WORKER_MAX_CONCURRENT_ACTIVITIES=1
AICHECK_REVIEW_GRAPH_TASK_QUEUE=review.graph
AICHECK_REVIEW_LLM_TASK_QUEUE=review.llm
AICHECK_REVIEW_RETRIEVAL_TASK_QUEUE=review.retrieval
AICHECK_REVIEW_VALIDATION_TASK_QUEUE=review.validation
AICHECK_REVIEW_LLM_EXECUTION=litellm
AICHECK_REVIEW_CONVERSATION_LLM_EXECUTION=litellm
AICHECK_REVIEW_CONVERSATION_AGENT_MAX_TURNS=6
AICHECK_REVIEW_CONVERSATION_TIMEOUT_SECONDS=60
AICHECK_LANGGRAPH_DISABLE=false
AICHECK_LANGGRAPH_CHECKPOINT_DISABLE=false
AICHECK_LANGGRAPH_CHECKPOINT_SETUP=false
WORKFLOW_POSTGRES_DB=workflow
LANGGRAPH_CHECKPOINT_DSN=postgresql://aicheck:replace-with-strong-postgres-password@postgres:5432/workflow

AICHECK_MINIO_ENDPOINT=minio:9000
AICHECK_MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
AICHECK_MINIO_SECURE=false

AICHECK_OCR_BASE_URL=http://ocr-service:8010
AICHECK_MINERU_BASE_URL=https://mineru.net
AICHECK_MINERU_API_KEY=replace-with-mineru-api-key
AICHECK_MINERU_MODEL_VERSION=vlm
AICHECK_MINERU_TIMEOUT_SECONDS=60
AICHECK_MINERU_POLL_INTERVAL_SECONDS=3
AICHECK_MINERU_JOB_TIMEOUT_SECONDS=1800
AICHECK_MINERU_MAX_DOWNLOAD_BYTES=536870912
AICHECK_OCR_PROVIDER_MODE=hybrid_auto
AICHECK_ALIYUN_OCR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
AICHECK_ALIYUN_OCR_API_KEY=replace-with-qwen-ocr-api-key
AICHECK_ALIYUN_OCR_MODEL=qwen3.5-ocr
AICHECK_ALIYUN_OCR_TIMEOUT_SECONDS=60
AICHECK_ALIYUN_OCR_MAX_OUTPUT_TOKENS=16384
AICHECK_OCR_MAX_LONG_SIDE=1920
AICHECK_OCR_ALLOW_LOCAL_HEAVY_FALLBACK=false
AICHECK_OCR_ALLOW_SILENT_PROVIDER_FALLBACK=false
AICHECK_OCR_PIPELINE_MODE=shadow
AICHECK_OCR_PIPELINE_VERSION=ocr-accuracy-first@1
AICHECK_OCR_PIPELINE_PROFILE_ALLOWLIST=ndt_rt_report_v1,quality_certificate_v1,engineering_drawing_list_v1,piping_characteristic_list_v1,comprehensive_material_list_v1
AICHECK_OCR_QWEN_IMAGE_POLICY=page_and_roi
AICHECK_OCR_QWEN_MAX_PAGES=60
AICHECK_OCR_QWEN_MAX_TOKENS=3200
AICHECK_OCR_QWEN_TIMEOUT_SECONDS=180
AICHECK_OCR_MAX_CONCURRENT_HEAVY=1
AICHECK_OCR_CACHE_MAX_AGE_HOURS=72
AICHECK_OCR_CACHE_MAX_BYTES=5368709120
AICHECK_EMBEDDING_CHECKPOINT_BATCH_SIZE=8

# Retained experimental GPU Document AI path. It is disabled for the current CPU-only deployment.
AICHECK_DOCUMENT_AI_MODE=off
AICHECK_DOCUMENT_AI_BASE_URL=
AICHECK_DOCUMENT_AI_API_KEY=
AICHECK_DOCUMENT_AI_PROFILE_ALLOWLIST=ndt_rt_report_v1,quality_certificate_v1,engineering_drawing_list_v1,piping_characteristic_list_v1,comprehensive_material_list_v1
AICHECK_DOCUMENT_AI_TIMEOUT_SECONDS=180

# End-to-end audit A/B. Both branches are advisory-only and execute on the server.
AICHECK_AUDIT_MODEL_COMPARISON_MODE=off
AICHECK_AUDIT_MODEL_COMPARISON_SAMPLE_RATE=1.0
AICHECK_QWEN_VL_AUDIT_MODEL=qwen3.7-plus
AICHECK_DEEPSEEK_AUDIT_MODEL=deepseek-v4-pro
AICHECK_DEEPSEEK_AUDIT_MAX_TOKENS=2400
AICHECK_DEEPSEEK_AUDIT_TIMEOUT_SECONDS=180
DEEPSEEK_API_BASE=https://api.deepseek.com
AICHECK_AGENTDESIGN_BACKEND=/opt/agentdesign/mvp-system/backend
AICHECK_OCR_ALLOW_PLACEHOLDER=false
AICHECK_OCR_OFFLINE_ONLY=true
AICHECK_OCR_DISABLE_NETWORK=true
PADDLEOCR_MODEL_DIR=/models/paddleocr
PADDLEX_MODEL_DIR=/models/paddlex
PADDLEOCR_VL_MODEL_DIR=/models/paddleocr-vl
AICHECK_ENABLE_PADDLEOCR_VL=false
DOCLING_ARTIFACTS_PATH=/models/docling
AICHECK_OCR_SUBPROCESS_PYTHON=/usr/local/bin/python
AICHECK_PADDLEOCR_DET_MODEL_DIR=/models/paddleocr/PP-OCRv6_medium_det
AICHECK_PADDLEOCR_REC_MODEL_DIR=/models/paddleocr/PP-OCRv6_medium_rec
AICHECK_PPSTRUCTURE_LAYOUT_MODEL_DIR=/models/paddlex/PP-DocLayout-L
AICHECK_PPSTRUCTURE_WIRED_TABLE_STRUCTURE_MODEL_DIR=/models/paddlex/SLANeXt_wired
AICHECK_PPSTRUCTURE_WIRED_TABLE_CELLS_MODEL_DIR=/models/paddlex/RT-DETR-L_wired_table_cell_det
AICHECK_PPSTRUCTURE_WIRELESS_TABLE_STRUCTURE_MODEL_DIR=/models/paddlex/SLANeXt_wireless
AICHECK_PPSTRUCTURE_WIRELESS_TABLE_CELLS_MODEL_DIR=/models/paddlex/RT-DETR-L_wireless_table_cell_det
AICHECK_ENABLE_OPENCV_TABLE_GRID=true
AICHECK_OPENCV_TABLE_GRID_MAX_CELLS=1800
AICHECK_ENABLE_PADDLEX_SEAL_PIPELINE=auto
AICHECK_SEAL_DET_MODEL_DIR=/models/paddlex/PP-OCRv4_server_seal_det
AICHECK_SEAL_REC_MODEL_DIR=/models/paddleocr/PP-OCRv4_server_rec
AICHECK_ENABLE_AGENTDESIGN_SEAL_OCR=false
AICHECK_AGENTDESIGN_SEAL_TIMEOUT=140
AICHECK_AGENTDESIGN_SEAL_MAX_CANDIDATES=6
AICHECK_AGENTDESIGN_SEAL_MAX_OCR_CANDIDATES=3
AICHECK_OCR_PREPROCESS_CACHE_DIR=/tmp/aicheck-ocr-preprocess-cache
AICHECK_OCR_DISABLE_VARIANT_CACHE=false
AICHECK_OCR_RESULT_CACHE_DIR=/tmp/aicheck-ocr-result-cache
AICHECK_OCR_DISABLE_RESULT_CACHE=false
AICHECK_OCR_ENGINE_RESULT_CACHE_DIR=/tmp/aicheck-ocr-engine-result-cache
AICHECK_OCR_DISABLE_ENGINE_RESULT_CACHE=false

LITELLM_BASE_URL=http://litellm-service:4000
LITELLM_POSTGRES_DB=litellm
AICHECK_LITELLM_NO_PROXY=127.0.0.1,localhost,::1,postgres,embedding-service
AICHECK_LITELLM_STRICT_PROVIDER_HEALTH=true

AICHECK_REQUIRE_AUTH=true
AICHECK_ENABLE_DEMO_USERS=false
AICHECK_PUBLIC_HOST=aicheck.example.com
AICHECK_PUBLIC_ORIGIN=https://aicheck.example.com
AICHECK_MATERIAL_REVIEW_POINTS_ASSET=/app/config/material_review_points.json
# 后端 CNSE 单位查询服务。origin 仅接受源码白名单内的 HTTPS 官方域名。
AICHECK_CNSE_ORIGIN=https://cnse.e-cqs.cn
AICHECK_CNSE_MIN_CONFIDENCE=0.50
# 仅用于 apps.api.cnse_service 独立对外部署；请配置至少 32 字节随机值。
AICHECK_CNSE_API_KEY=
# R12 人工核验弹窗打开的全国特种设备公示信息查询平台地址；由部署环境配置并纳入白名单。
AICHECK_SPECIAL_EQUIPMENT_REGISTRY_URL=
