{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIcheck Business Pack",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "domainType",
    "roles",
    "nodeTemplates",
    "materialTypes",
    "workflowStateMachines",
    "ruleSets",
    "reportTemplates"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "domainType": { "type": "string" },
    "status": { "enum": ["draft", "candidate", "published", "deprecated", "archived"] },
    "roles": { "type": "array", "minItems": 1 },
    "nodeTemplates": { "type": "array", "minItems": 1 },
    "materialTypes": { "type": "array", "minItems": 1 },
    "workflowStateMachines": { "type": "array", "minItems": 1 },
    "workflowActions": { "type": "array", "items": { "type": "string" } },
    "ruleSets": { "type": "array", "minItems": 1 },
    "reportTemplates": { "type": "array", "minItems": 1 },
    "agentSops": { "type": "array" },
    "fixtures": {
      "type": "object",
      "properties": {
        "projects": { "type": "array" },
        "documents": { "type": "array" },
        "bindings": { "type": "array" },
        "evidenceLinks": { "type": "array" },
        "extractedFields": { "type": "array" },
        "aiRuns": { "type": "array" },
        "reviewFindings": { "type": "array" },
        "projectMembers": { "type": "array" },
        "todos": { "type": "array" },
        "messages": { "type": "array" },
        "knowledgeSources": { "type": "array" },
        "knowledgeTasks": { "type": "array" }
      }
    },
    "knowledgeProfiles": { "type": "array" },
    "fieldExtractors": { "type": "array" },
    "uiHints": { "type": "object" },
    "migrationHints": { "type": "object" }
  }
}
