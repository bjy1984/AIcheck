ARG AICHECK_TEST_BASE_IMAGE=aicheck-api:local
FROM ${AICHECK_TEST_BASE_IMAGE}
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git zsh \
    && rm -rf /var/lib/apt/lists/*
# Scripts retaining /app compatibility must resolve to the synchronized checkout,
# never to the older source baked into the production base image.
RUN rm -rf /app && ln -s /ws/backend /app
ENV PYTHONPATH=/ws/backend
WORKDIR /ws/backend
USER aicheck
