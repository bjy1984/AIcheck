FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AICHECK_OCR_OFFLINE_ONLY=true \
    AICHECK_OCR_DISABLE_NETWORK=true \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.12 python3-pip libgomp1 libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-ocr.txt ./
RUN pip install -r requirements.txt -r requirements-ocr.txt \
    && groupadd --system aicheck \
    && useradd --system --gid aicheck --home-dir /app aicheck
COPY . .
RUN chown -R aicheck:aicheck /app

USER aicheck

EXPOSE 8010
