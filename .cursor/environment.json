{
  "name": "AIcheck (FastAPI + Vue)",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && .venv/bin/uvicorn apps.api.main:app --host 127.0.0.1 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && pnpm run dev:live:frontend-only"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 4000 },
    { "name": "backend", "port": 8000 }
  ]
}
