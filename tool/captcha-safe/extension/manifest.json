{
  "manifest_version": 3,
  "name": "Captcha Safe",
  "version": "0.6.0",
  "key": "",
  "description": "Runs the CNSE captcha and organization lookup entirely through same-origin APIs without page interaction.",
  "minimum_chrome_version": "120",
  "incognito": "split",
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Captcha Safe"
  },
  "permissions": [
    "offscreen",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://cnse.e-cqs.cn/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
