+def pgvector_table_for_dimensions(dimensions: int) -> str:
+    """Per-dimension vector tables: the legacy 1024-dim table keeps its name for
+    backward compatibility; other embedding sizes (Qwen3-4B @ 2560, 8B @ 4096)
