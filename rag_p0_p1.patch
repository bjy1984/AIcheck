+    saturation, and document-length normalization — replacing the previous
+    substring-count scoring that had no IDF and favored long chunks."""
+    import math
+
+    query_terms = [term for term in dict.fromkeys(lexical_terms(str(query or ""))) if term]
+    if not candidates or not query_terms:
+        return {}
+    doc_terms: list[tuple[str, dict[str, int], int]] = []
+    for clause in candidates:
+        terms = lexical_terms(clause_lexical_haystack(clause))
+        counts: dict[str, int] = {}
+        for term in terms:
